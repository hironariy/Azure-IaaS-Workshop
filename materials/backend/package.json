    "start": "node dist/app.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "seed": "ts-node scripts/seed.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
